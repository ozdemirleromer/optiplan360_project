# ============================================================
# OptiPlan360 — Frontend Ortam Değişkenleri
# Bu dosyayı kopyalayın: cp .env.example .env
# ============================================================

# ── API Bağlantısı ─────────────────────────────────────────────────
# Backend API URL (development)
VITE_API_URL=http://localhost:8080

# Backend API proxy target (vite dev server için)
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Production API URL (build zamanı kullanılır)
# VITE_API_URL=https://api.optiplan360.com

# ── Uygulama Ayarları ─────────────────────────────────────────────
# Uygulama başlığı
VITE_APP_TITLE=OptiPlan360

# Uygulama ortamı (development | production)
VITE_APP_ENV=development

# Debug modu (development'da true)
VITE_DEBUG_MODE=true

# ── Feature Flags ───────────────────────────────────────────────────
# OptiPlanning entegrasyonu
VITE_FEATURE_OPTIPLANNING=true

# OCR modülü
VITE_FEATURE_OCR=true

# Customer portal linki
VITE_CUSTOMER_PORTAL_URL=http://localhost:3005

# ── Dosya Yükleme ───────────────────────────────────────────────────
# Max dosya boyutu (MB)
VITE_MAX_FILE_SIZE=10

# İzin verilen dosya tipleri
VITE_ALLOWED_FILE_TYPES=.xlsx,.xls,.csv,.pdf,.jpg,.jpeg,.png

# ── Real-time ───────────────────────────────────────────────────────
# WebSocket URL (opsiyonel)
# VITE_WS_URL=ws://localhost:8080/ws

# Polling interval (ms)
VITE_POLLING_INTERVAL=5000

# ── Entegrasyonlar ──────────────────────────────────────────────────
# Mikro entegrasyonu aktif
VITE_MIKRO_INTEGRATION=true

# OCR kanalları aktif
VITE_OCR_CHANNELS=manual,watch_folder,scanner

# ── Güvenlik ────────────────────────────────────────────────────────
# Session timeout (dakika)
VITE_SESSION_TIMEOUT=480

# Token yenileme eşiği (dakika)
VITE_TOKEN_REFRESH_THRESHOLD=30
